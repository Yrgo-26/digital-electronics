% dtbook.sty - the design of "Digitalteknik" as a book.
%
% Every visual decision lives here, so the chapters describe content and nothing else. The design
% is the one the QAcademy books use, Modern Embedded C++, Embedded Assembly and Digital Design with
% VHDL: the same page, type and inks, set in Swedish, with AVR assembly as the code on the page and
% the figures taken from diagrams/ as vector drawings.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dtbook}[2026/09/11 Digitalteknik book design]

% ------------------------------------------------------------------------------------------
% Page. 7.5 x 9.25 in, a common trim for technical texts; the text block is wide enough for an
% 84-column line of code at the listing size.
% ------------------------------------------------------------------------------------------
\RequirePackage[
  paperwidth=7.5in, paperheight=9.25in,
  inner=0.85in, outer=1.15in, top=0.95in, bottom=1.0in,
  headheight=14pt, headsep=18pt, footskip=30pt]{geometry}

% ------------------------------------------------------------------------------------------
% Type. Palatino for the text, and DejaVu Sans Mono for code: a register name reads the same in a
% sentence as in a listing, and as in a figure, which diagrams/style.py draws in the same face.
% ------------------------------------------------------------------------------------------
\RequirePackage{amsmath}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{TeX Gyre Pagella}
\setsansfont{TeX Gyre Heros}[Scale=MatchLowercase]
% A space inside inline code may stretch a little, as a word space does; listings set their own
% fixed columns and are not affected.
\setmonofont{DejaVu Sans Mono}[Scale=0.84, HyphenChar=None, WordSpace={1,0.4,0.15}]
\setmathfont{TeX Gyre Pagella Math}
\RequirePackage[protrusion=true, expansion=true, tracking=true]{microtype}
\SetTracking{encoding=*, shape=sc}{40}

% ------------------------------------------------------------------------------------------
% Language. The book is Swedish: hyphenation, and the names LaTeX gives its parts (Kapitel,
% Bilaga, Figur, Innehåll). In maths, a comma between digits is a decimal comma, as in 62,5 ns,
% and takes no space after it.
% ------------------------------------------------------------------------------------------
\RequirePackage{polyglossia}
\setdefaultlanguage{swedish}
\RequirePackage{icomma}
% \enquote{...} quotes the Swedish way, ”så här”.
\RequirePackage[autostyle]{csquotes}

% ------------------------------------------------------------------------------------------
% Colour. The accents are the figures' own inks, ACCENT_COLOR and ACCENT_COLOR_2 in
% diagrams/style.py, so a Karnaugh group is the same red on the page as in the drawing.
% ------------------------------------------------------------------------------------------
\RequirePackage[table]{xcolor}
\definecolor{accent}{HTML}{C00000}
\definecolor{accent2}{HTML}{0050B3}
\definecolor{accent3}{HTML}{2E7D32}
\definecolor{muted}{HTML}{767676}
\definecolor{ink}{HTML}{3A3A3A}
\definecolor{fillaccent}{HTML}{F4D7D7}
\definecolor{fillaccent2}{HTML}{D6E4F5}
\definecolor{fillaccent3}{HTML}{D9EDDA}
\definecolor{fillmuted}{HTML}{E8E8E8}
\definecolor{codebg}{HTML}{F6F5F2}
\definecolor{rule}{HTML}{BBBBBB}

% ------------------------------------------------------------------------------------------
% Structure: chapter openers, section heads, running heads.
% ------------------------------------------------------------------------------------------
\RequirePackage{titlesec}
\RequirePackage{titletoc}

\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\color{accent}\large\scshape\lsstyle\MakeLowercase{\chaptertitlename}\enspace\thechapter}
  {1.2ex}
  {\fontsize{26}{30}\selectfont\bfseries}
  [\vspace{1.4ex}{\color{rule}\titlerule[0.6pt]}]
\titleformat{name=\chapter, numberless}[display]
  {\normalfont\raggedright}
  {}
  {0pt}
  {\fontsize{26}{30}\selectfont\bfseries}
  [\vspace{1.4ex}{\color{rule}\titlerule[0.6pt]}]
\titlespacing*{\chapter}{0pt}{0.35in}{0.3in}

\titleformat{\section}
  {\normalfont\Large\bfseries\raggedright}
  {\color{accent}\thesection}{0.7em}{}
\titlespacing*{\section}{0pt}{3.2ex plus 1ex minus .2ex}{1.4ex plus .2ex}

\titleformat{\subsection}
  {\normalfont\large\bfseries\raggedright}
  {\color{accent}\thesubsection}{0.7em}{}
\titlespacing*{\subsection}{0pt}{2.6ex plus 1ex minus .2ex}{1.0ex plus .2ex}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\itshape\raggedright}
  {}{0em}{}
\titlespacing*{\subsubsection}{0pt}{2ex plus .8ex minus .2ex}{0.6ex plus .2ex}

\titleformat{\paragraph}[runin]
  {\normalfont\normalsize\bfseries}
  {}{0em}{}[.]
\titlespacing*{\paragraph}{0pt}{1.4ex plus .5ex minus .2ex}{0.6em}

\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

% Contents: chapters bold with their number in the accent, sections indented beneath, and every
% page number right-aligned in a box of its own, so a three-digit one never meets the leaders.
\titlecontents{chapter}[0pt]
  {\addvspace{1.4ex}\bfseries}
  {\makebox[2em][l]{\color{accent}\thecontentslabel}}
  {}
  {\hfill\makebox[2.2em][r]{\contentspage}}
\titlecontents{section}[2em]
  {\addvspace{0.2ex}}
  {\makebox[2.6em][l]{\thecontentslabel}}
  {}
  {\titlerule*[0.6pc]{.}\makebox[2.2em][r]{\contentspage}}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\enspace #1}}
\fancyhead[LE]{\small\thepage\qquad\scshape\lsstyle\MakeLowercase{\leftmark}}
\fancyhead[RO]{\small\scshape\lsstyle\MakeLowercase{\rightmark}\qquad\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}}
\RequirePackage{emptypage}

% ------------------------------------------------------------------------------------------
% Text.
% ------------------------------------------------------------------------------------------
% Pages end where their text ends. The class default stretches every gap on a page to square
% the bottom off, which a page with a long listing or a figure pushed to the next one cannot
% survive.
\raggedbottom
% With a ragged bottom there is no reason to leave one line of a paragraph alone on a page.
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
% Inline code is set in a monospaced face whose spaces cannot stretch, and a name such as
% delay_ms or m328Pdef.inc cannot be hyphenated; a little emergency stretch lets the paragraph
% builder loosen a line around one rather than push it into the margin.
\setlength{\emergencystretch}{2.5em}
\tolerance=1000
\setlength{\parindent}{1.2em}
\linespread{1.06}
\RequirePackage[shortlabels]{enumitem}
\setlist{itemsep=0.25ex, topsep=0.8ex, parsep=0pt}
\setlist[itemize]{leftmargin=1.4em, label={\color{accent}\textbullet}}
\setlist[itemize,2]{leftmargin=1.2em, label={\color{muted}\textendash}}
\setlist[itemize,3]{leftmargin=1.2em, label={\color{muted}\textperiodcentered}}
\setlist[enumerate]{leftmargin=1.6em, label={\bfseries\arabic*.}}

% Inline code. \detokenize is what lets a name like delay_ms, an expression like X = A'B + BC' or
% a number like $19 be written as it appears in the source, without escaping; dtbook.lua undoes
% the two things \detokenize does to it (a doubled # and a space after a backslash-word). A
% literal % or an unbalanced brace is written \%, \{ or \}. \file is for file names, which are
% long and need to break at a slash. Robust, so it survives the trip through the contents and the
% running heads.
\directlua{dofile(kpse.find_file("dtbook.lua"))}
\DeclareRobustCommand{\code}[1]{%
  {\ttfamily\directlua{dtbook_code("\luaescapestring{\detokenize{#1}}")}}}
% A running head is set in small capitals by lowercasing it; code in a heading keeps its case,
% because PORTB and portb are the same register to the assembler but not to the reader.
\ExplSyntaxOn
\tl_put_right:Nn \l_text_case_exclude_arg_tl { \code }
\ExplSyntaxOff
\RequirePackage{xurl}
\urlstyle{tt}
% xurl lets a URL break anywhere, which a long datasheet link needs; a file name breaks only at
% a slash or a dot, so no name is ever split in half.
\DeclareUrlCommand{\file}{\urlstyle{tt}\def\UrlBreaks{\do\/\do\.}\def\UrlBigBreaks{}}

% Section references, as Swedish writes them: "se avsnitt 4.1.3". The lectures' "(A.3)" is
% \secref{c4:a3}; \Secref starts a sentence.
\newcommand{\secref}[1]{avsnitt~\ref{#1}}
\newcommand{\Secref}[1]{Avsnitt~\ref{#1}}

% A lead-in for the notes the lectures are full of: "Obs:", "Tips:", "Fälla:".
\newcommand{\note}[1][Obs]{\textbf{#1:}\ }

% ------------------------------------------------------------------------------------------
% Tables. Rules only where they separate; never a vertical one.
% ------------------------------------------------------------------------------------------
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}p}
\newcolumntype{Y}{>{\centering\arraybackslash}X}
\setlength{\aboverulesep}{0.5ex}
\setlength{\belowrulesep}{0.5ex}
\newcommand{\thead}[1]{\textbf{#1}}
% A table set in the flow of the text, full measure, one size down.
\newenvironment{booktable}[1]
  {\par\smallskip\noindent\small\tabularx{\linewidth}{#1}\toprule}
  {\bottomrule\endtabularx\par\smallskip}
% The same, at its natural width and centred, for tables of short cells: every truth table.
\newenvironment{narrowtable}[1]
  {\par\smallskip\begin{center}\small\begin{tabular}{#1}\toprule}
  {\bottomrule\end{tabular}\end{center}\par\smallskip}
% A table to be filled in by hand, at a lab station or on paper: full measure, with rows tall
% enough to write in and a light rule under each.
\newenvironment{filltable}[1]
  {\par\smallskip\noindent\small\renewcommand{\arraystretch}{1.7}%
   \tabularx{\linewidth}{#1}\toprule}
  {\bottomrule\endtabularx\par\smallskip}
\newcommand{\fillrule}{\\\arrayrulecolor{rule}\midrule\arrayrulecolor{black}}

% ------------------------------------------------------------------------------------------
% Figures. The drawings diagrams/ makes are rendered as vector PDFs into build/figures by
% figures.py, and set at one scale, so a label is the same size in all of them, exactly as
% diagrams/style.py intends: 15pt in the drawing, a little under the text size on the page. A
% figure too wide for that scale is fitted to the page instead and allowed a little of each
% margin. The Microchip Studio screenshots are included from info/images as they are, at a
% width given where each is placed.
% ------------------------------------------------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{build/figures/}{../}}
\RequirePackage[export]{adjustbox}
\RequirePackage{float}
\RequirePackage{caption}
\captionsetup{font=small, labelfont={bf,color=accent}, labelsep=quad,
  justification=centering, skip=6pt}
\newcommand{\figscale}{0.64}
\newlength{\figmax}
\setlength{\figmax}{\dimexpr\textwidth+0.6in\relax}
\newcommand{\drawing}[1]{%
  \makebox[\textwidth][c]{\adjustbox{scale=\figscale, max width=\figmax,
    max height=0.72\textheight}{\includegraphics{#1}}}}
% \bookfigure[placement]{name}{caption}{label}: a figure drawn by diagrams/, by its name there
% (diagrams/build.py --list). The default placement pins the figure where it is written; a figure
% too tall to fit below its introduction can be let float to the next page instead.
\newcommand{\bookfigure}[4][H]{%
  \begin{figure}[#1]
    \centering
    \drawing{#2}
    \caption{#3}\label{#4}
  \end{figure}}
% \bookimage[placement]{width}{path}{caption}{label}: a screenshot, by its path from the
% repository root, at a fraction of the text width.
\newcommand{\bookimage}[5][H]{%
  \begin{figure}[#1]
    \centering
    \includegraphics[width=#2\textwidth]{#3}
    \caption{#4}\label{#5}
  \end{figure}}

% ------------------------------------------------------------------------------------------
% Code. A tinted block with a coloured edge; the edge says which language it is. Red for AVR
% assembly, grey for what a tool printed back or anything that is plain text.
% ------------------------------------------------------------------------------------------
\RequirePackage{listings}
\RequirePackage[most]{tcolorbox}

% AVR assembly as the assembler reads it: case-insensitive, every instruction the course uses as
% a keyword, and the directives and the two byte functions as a second class, in the accent. A
% directive begins with a dot, which is therefore a letter here.
\lstdefinelanguage{avrasm}{
  alsoletter={.},
  sensitive=false,
  morekeywords={adc,add,adiw,and,andi,asr,brcc,brcs,breq,brge,brlo,brlt,brmi,brne,brpl,brsh,
    cbi,clc,clr,com,cp,cpc,cpi,dec,eor,in,inc,ldi,lds,lsl,lsr,mov,movw,neg,nop,or,ori,out,pop,
    push,rcall,ret,rjmp,rol,ror,sbc,sbci,sbi,sbic,sbis,sbiw,sbrc,sbrs,sec,ser,sts,sub,subi,swap,
    tst},
  morekeywords=[2]{.org,.include,.equ,.def,.cseg,.dseg,.eseg,.byte,.db,.dw,.exit,low,high},
  morecomment=[l]{;},
  morestring=[b]",
}

\lstdefinestyle{base}{
  basicstyle=\ttfamily\small,
  columns=fixed,
  keepspaces=true,
  showstringspaces=false,
  upquote=true,
  tabsize=4,
  breaklines=true,
  breakatwhitespace=true,
  % A wrapped line is marked at both ends. Boxed, because LuaTeX will not take colour or maths
  % loose inside the discretionary a line break is made of.
  prebreak={\mbox{\textcolor{muted}{\tiny$\hookleftarrow$}}},
  postbreak={\mbox{\textcolor{muted}{\tiny$\hookrightarrow$}\space}},
  aboveskip=0pt, belowskip=0pt,
  commentstyle=\color{muted},
  stringstyle=\color{accent2},
}
\lstdefinestyle{asm}{style=base, language=avrasm,
  keywordstyle=\color{accent2!85!black}\bfseries,
  keywordstyle=[2]\color{accent}}
\lstdefinestyle{shell}{style=base, language=bash,
  keywordstyle={}, morekeywords={}, deletekeywords={test}}
\lstdefinestyle{output}{style=base, language={}}

\tcbset{
  codeblock/.style={
    enhanced, listing only, breakable,
    colback=codebg, colframe=codebg, boxrule=0pt, arc=0pt, outer arc=0pt,
    left=8pt, right=6pt, top=4pt, bottom=4pt,
    before skip=1.2ex plus 2pt, after skip=1.4ex plus 2pt,
    borderline west={2pt}{0pt}{#1}},
}
\newtcblisting{asmcode}{codeblock=accent!70, listing options={style=asm}}
\newtcblisting{shell}{codeblock=accent2!70, listing options={style=shell}}
\newtcblisting{console}{codeblock=muted!60, listing options={style=output}}

% A drawing made of text: a binary addition with its carries, a calculation aligned in columns,
% a box drawing, and any other plain-text block with a character outside ASCII in it, such as a
% middle dot, an arrow or a Swedish letter. listings cannot set those, it reorders and drops them,
% so this is verbatim text in the box a console listing uses, which keeps every column where the
% lecture puts it.
\RequirePackage{fancyvrb}
\RequirePackage{newunicodechar}
\newunicodechar{⋮}{\makebox[\fontcharwd\font`M]{$\vdots$}}
\newtcolorbox{textdrawingbox}{codeblock=muted!60}
\newenvironment{textdrawing}
  {\VerbatimEnvironment\begin{textdrawingbox}\begin{Verbatim}[fontsize=\small]}
  {\end{Verbatim}\end{textdrawingbox}}

% A program typeset straight from the repository, so the book and the code cannot drift apart.
% The argument is the path from the repository root, which is also what is printed. The file is
% read from build/code/, where the Makefile copies it without the test block ci/simtest.py reads
% at its end: that block is for the course's CI, not for the reader.
\newtcbinputlisting{\asmfile}[1]{codeblock=accent!70, listing options={style=asm},
  listing file={build/code/#1},
  title={\detokenize{#1}}, detach title,
  before upper={\noindent{\scriptsize\ttfamily\color{muted}\tcbtitletext}\par\vspace{3pt}}}

% ------------------------------------------------------------------------------------------
% Boxes in the text.
% ------------------------------------------------------------------------------------------
% An aside: something true that the surrounding text is not about.
\newtcolorbox{aside}[1][]{
  enhanced, breakable,
  colback=fillaccent2!45, colframe=fillaccent2!45, boxrule=0pt, arc=0pt,
  left=10pt, right=10pt, top=6pt, bottom=6pt,
  borderline west={2.5pt}{0pt}{accent2},
  before skip=2ex, after skip=2ex,
  fontupper=\small,
  #1}
% A warning: the lab safety rules, and anything else that can break the equipment.
\newtcolorbox{warning}[1][]{
  enhanced, breakable,
  colback=fillaccent!45, colframe=fillaccent!45, boxrule=0pt, arc=0pt,
  left=10pt, right=10pt, top=6pt, bottom=6pt,
  borderline west={2.5pt}{0pt}{accent},
  before skip=2ex, after skip=2ex,
  fontupper=\small,
  #1}
% The box that opens a chapter, listing what is in it.
\newtcolorbox{chapterbox}[1]{
  enhanced, breakable,
  colback=white, colframe=rule, boxrule=0.5pt, arc=0pt,
  left=10pt, right=10pt, top=8pt, bottom=6pt,
  fonttitle=\small\scshape\lsstyle, coltitle=accent, colbacktitle=white,
  attach boxed title to top left={xshift=8pt, yshift=-2.2mm},
  boxed title style={boxrule=0pt, arc=0pt, left=3pt, right=3pt, top=0pt, bottom=0pt},
  title={#1},
  before skip=2ex, after skip=2.5ex,
  fontupper=\small}

% ------------------------------------------------------------------------------------------
% Every heading from here on ends with \@afterheading, so the paragraph after it starts flush
% left, as it does after a \section.
%
% Exercises. The lectures number their exercises within the lecture; here each exercise is
% numbered within the chapter, so that exercise 3 of L04 is Övning 4.3 and can never be mistaken
% for avsnitt 4.3. Each carries its kind, as the lectures mark it, one tag each:
%   Förståelse      explain something from the chapter in your own words.
%   Räkna för hand  work something out on paper: a conversion, a simplification, a cycle count.
%   Konstruktion    design a solution: a gate network, a contact network, a flow chart.
%   Program         write assembly and run it in the simulator.
%   Kontroll        the chapter's cross-check: work it out by hand, check it with a tool, and
%                   explain why the two agree. The one tag in the accent itself.
%   Fördjupning     an extra, for the reader who wants to go further; an outlined tag.
% ------------------------------------------------------------------------------------------
\RequirePackage{needspace}
\newcounter{exercise}[chapter]
\renewcommand{\theexercise}{\thechapter.\arabic{exercise}}
\newcommand{\kindtag}[2][fillmuted]{%
  \tcbox[on line, colback=#1, colframe=#1, boxrule=0pt, arc=1.5pt,
    left=3pt, right=3pt, top=1pt, bottom=1pt, boxsep=0pt]{%
    \small\scshape\lsstyle\MakeLowercase{#2}}}
% The Kontroll tag: white on the accent, the one tag that stands out on the page.
\newcommand{\accenttag}[1]{%
  \tcbox[on line, colback=accent, colframe=accent, coltext=white, boxrule=0pt, arc=1.5pt,
    left=3pt, right=3pt, top=1pt, bottom=1pt, boxsep=0pt]{%
    \small\scshape\lsstyle\MakeLowercase{#1}}}
% The Fördjupning tag: an outline only, since it says how far to go rather than what to do.
\newcommand{\outlinetag}[1]{%
  \tcbox[on line, colback=white, colframe=muted, boxrule=0.4pt, arc=1.5pt,
    left=2.6pt, right=2.6pt, top=0.6pt, bottom=0.6pt, boxsep=0pt]{%
    \small\scshape\lsstyle\color{muted}\MakeLowercase{#1}}}
% The fill each kind is tagged in; anything else is grey.
\ExplSyntaxOn
\cs_new_protected:Npn \dtbook_kind:n #1
  {
    \str_case:nnF {#1}
      {
        {Förståelse} { \kindtag[fillmuted]{#1} }
        {Räkna~för~hand} { \kindtag[fillaccent2]{#1} }
        {Konstruktion} { \kindtag[fillaccent3]{#1} }
        {Program} { \kindtag[fillaccent]{#1} }
        {Kontroll} { \accenttag{#1} }
        {Fördjupning} { \outlinetag{#1} }
      }
      { \kindtag{#1} }
  }
% \kinds{Förståelse, Fördjupning}: one tag per kind, a thin space apart.
\NewDocumentCommand \kinds { m }
  { \clist_map_inline:nn {#1} { \dtbook_kind:n {##1} } { \, } }
\ExplSyntaxOff
% \@taggedheading{heading}{tag}: a heading with a tag at the right margin, set the way \worth sets
% a part's marks. A heading that is long runs on ragged, never stretched; the tag stays on its
% last line if it fits there, and otherwise goes flush right on a line of its own.
\newcommand{\@taggedheading}[2]{%
  \begingroup\rightskip=0pt plus 1fil\parfillskip=0pt\relax
  \noindent#1\nobreak\hskip0pt plus 1fil\penalty50\hskip1.2em\hbox{}\nobreak
  \hskip0pt plus 1fill#2\par\endgroup}
% \@keepwithnext{n}: make sure n lines fit below, unless a heading has just been set, which keeps
% itself with what follows; a \needspace there would add a page break between the two.
\newcommand{\@keepwithnext}[1]{\if@nobreak\else\needspace{#1}\fi}
% \exercise{Title}{Kind, Kind}
\newcommand{\exercise}[2]{%
  \par\addvspace{3ex plus 1ex}\@keepwithnext{8\baselineskip}%
  \refstepcounter{exercise}%
  \@taggedheading{{\large\bfseries{\color{accent}Övning~\theexercise}\quad #1}}{\kinds{#2}}%
  \nopagebreak\vspace{0.8ex}\@afterindentfalse\@afterheading}
% The lettered parts of an exercise, a) to e), as the lectures letter them.
% A list of parts interrupted by text, as in "Omvandla till binärt: a) ... Omvandla till
% hexadecimalt: e) ...", continues with \begin{parts}[start=5]. Not [resume], which would carry
% on from whichever list last resumed, in another exercise.
\newenvironment{parts}[1][]
  {\begin{enumerate}[label={\bfseries\alph*)}, leftmargin=1.8em, itemsep=0.8ex, #1]}
  {\end{enumerate}}
% A part of an exercise with a heading of its own, for the parts the lectures give a title:
% "a) För hand", "b) Med kalkylatorn".
\newcommand{\task}[1]{\par\addvspace{1.6ex}\needspace{4\baselineskip}%
  \noindent{\bfseries #1}\par\nopagebreak\vspace{0.3ex}\@afterindentfalse\@afterheading}

% ------------------------------------------------------------------------------------------
% The lab guides. A lab task is headed like an exercise, with its own number as the lectures give
% it (Uppgift 3, Del 14, F2) rather than a counter, and linkable by the label placed after it. The
% points where the lab is shown to the teacher are marked Redovisa, in the tag an exercise carries
% its kind in.
% ------------------------------------------------------------------------------------------
% \labtask[tag]{Uppgift 3}{OR}: the heading of one task; the optional tag goes at the margin.
\newcommand{\labtask}[3][]{%
  \par\addvspace{3ex plus 1ex}\@keepwithnext{8\baselineskip}%
  \def\@currentlabel{#2}%
  \@taggedheading{{\large\bfseries{\color{accent}#2}\quad #3}}%
    {\ifx\relax#1\relax\else\outlinetag{#1}\fi}%
  \nopagebreak\vspace{0.8ex}\@afterindentfalse\@afterheading}
% \redovisa{what is shown}: the point where the task is shown to the teacher.
\newcommand{\redovisa}[1]{\par\addvspace{1.2ex}\noindent
  \kindtag[fillaccent]{Redovisa}\enspace #1\par\addvspace{0.6ex}}
% \prep{F1}: the lead-in of one preparation task, done before the lab.
\newcommand{\prep}[1]{\par\addvspace{1.2ex}\noindent\textbf{#1.}\enspace}

% ------------------------------------------------------------------------------------------
% Solutions. The appendix that answers the exercises that are not programs: an entry per
% exercise, headed by its number and title and linked back to it, and each part's answer after
% its letter. \answer{c2:ex:1}{Title} opens an entry; \pt{a} opens a part. The programs the
% exercises ask for are not answered in the book.
% ------------------------------------------------------------------------------------------
\newcommand{\answer}[2]{\par\addvspace{2.6ex plus .6ex}\needspace{5\baselineskip}%
  \@taggedheading{{\bfseries\color{accent}Övning~\ref{#1}}\quad{\bfseries #2}}%
    {{\small\color{muted}sidan~\pageref{#1}}}%
  \nopagebreak\vspace{0.4ex}\@afterindentfalse\@afterheading}
\newcommand{\pt}[1]{\par\addvspace{0.8ex}\noindent\textbf{#1)}\enspace\ignorespaces}
% \ptnote{Kommentar}: a note to an answer outside its lettered parts.
\newcommand{\ptnote}[1]{\par\addvspace{0.8ex}\noindent\textit{#1:}\ \ignorespaces}
% \noanswer{text}: the place of an answer the book deliberately leaves out, a program.
\newcommand{\noanswer}[1]{\par\addvspace{0.8ex}\noindent{\color{muted}\itshape #1}\par}
% A chapter's heading inside the solutions: which chapter the entries below come from. It is in
% the contents, one level below the appendix, so each chapter's solutions can be found from there.
\newcommand{\answerchapter}[1]{%
  \par\addvspace{4ex plus 1ex}\needspace{10\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{\protect\numberline{\ref*{#1}}\nameref*{#1}}%
  \markright{Kapitel~\ref*{#1}\enspace\nameref*{#1}}%
  \noindent{\small\scshape\lsstyle\color{accent}kapitel~\ref*{#1}}\par\nopagebreak\vspace{0.2ex}%
  \noindent{\Large\bfseries\nameref*{#1}}\par
  \nopagebreak\vspace{0.4ex}{\color{rule}\hrule height 0.4pt}\par\nopagebreak\vspace{0.6ex}%
  \@afterindentfalse\@afterheading}

% ------------------------------------------------------------------------------------------
% The written exam. A question is numbered within its paper and carries its points in the tag an
% exercise carries its kind in; a part's points are set flush right at the end of the part, the
% way a printed paper sets them.
% ------------------------------------------------------------------------------------------
\newcounter{question}[chapter]
% \question{Title}{Points}
\newcommand{\question}[2]{%
  \par\addvspace{3.5ex plus 1ex}\needspace{6\baselineskip}%
  \refstepcounter{question}%
  \@taggedheading{{\large\bfseries{\color{accent}Fråga~\thequestion}\quad #1}}%
    {\kindtag{#2 p}}%
  \nopagebreak\vspace{0.8ex}\@afterindentfalse\@afterheading}
% \worth{N}: "(N p)" at the right margin, on the part's last line if it fits.
\newcommand{\worth}[1]{{\unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfill
  \mbox{\small\itshape (#1~p)}\parfillskip=0pt\finalhyphendemerits=0\par}}
% \qpart{a}: the lead-in of a lettered part of a question.
\newcommand{\qpart}[1]{\par\addvspace{1.2ex}\noindent\textbf{#1)}\enspace}
% \credit{text}: how the points of a part are given ("1 p per rätt omvandling"), set as the
% solutions set it: in italics, after the answer.
\newcommand{\credit}[1]{\par\addvspace{0.6ex}\noindent{\small\itshape #1}\par}
% \trap{text}: a named trap, a common mistake the part exists to catch, and what it costs.
\newcommand{\trap}[1]{\par\addvspace{0.6ex}\noindent{\small\textbf{Fälla:}\ #1}\par}
% \answersection{N}{Title}{Points}: the heading of the solution to one question, set like the
% paper's own \question one size up and numbered by the question it answers rather than by a
% section counter; it is in the contents and the running head, and linkable as \answerprefix:q:N.
\newcommand{\answerprefix}{ans}
\newcommand{\answersection}[3]{%
  \par\addvspace{4.5ex plus 1ex}\needspace{8\baselineskip}%
  \phantomsection\addcontentsline{toc}{section}{Fråga~#1: #2}%
  \markright{Fråga~#1\enspace #2}%
  \def\@currentlabel{#1}\label{\answerprefix:q:#1}%
  \@taggedheading{{\Large\bfseries{\color{accent}Fråga~#1}\quad #2}}{\kindtag{#3 p}}%
  \nopagebreak\vspace{1.2ex}\@afterindentfalse\@afterheading}
% \answerpart{a}{2}: the heading of the solution to one part, with what it is worth.
\newcommand{\answerpart}[2]{%
  \par\addvspace{2.2ex plus .6ex}\needspace{4\baselineskip}%
  \noindent{\bfseries\color{accent}#1)}\hfill\kindtag{#2~p}%
  \par\nopagebreak\vspace{0.5ex}\@afterindentfalse\@afterheading}

